{
	"schemaVersion": 1,
	"id": "cuemymusic",
	"version": "${version}",
	"name": "Cue My Music",
	"description": "A music player for the game's own soundtrack, with pitch, speed and an equalizer. Jukeboxes are left alone.",
	"authors": ["simply-sunny"],
	"contact": {
		"sources": "https://github.com/simply-sunny/cue-my-music",
		"issues": "https://github.com/simply-sunny/cue-my-music/issues"
	},
	"license": "MIT",
	"icon": "assets/cuemymusic/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["mix.cuemymusic.CueMyMusicClient"],
		"modmenu": ["mix.cuemymusic.ModMenuIntegration"]
	},
	"mixins": ["cuemymusic.mixins.json"],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"modmenu": "*"
	}
}
