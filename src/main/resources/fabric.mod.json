{
  "schemaVersion": 1,
  "id": "cue_my_music",
  "version": "${version}",
  "name": "Cue My Music",
  "description": "Browse, preview, and control Minecraft music through a native client-side library.",
  "authors": ["You"],
  "contact": {
    "homepage": "https://github.com/simply-sunny/cue-my-music",
    "sources": "https://github.com/simply-sunny/cue-my-music"
  },
  "license": "MIT",
  "icon": "assets/cue_my_music/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": ["com.cuemymusic.CueMyMusic"],
    "client": ["com.cuemymusic.client.CueMyMusicClient"],
    "modmenu": ["com.cuemymusic.client.integration.ModMenuIntegration"]
  },
  "mixins": ["cue_my_music.mixins.json"],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "26.2",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
